@page "/memory"
@inherits ViewModelComponentBase<MemoryViewModel>
@inject HomeViewModel HomeVM
@inject ApiClient ApiClient
@inject AssetsViewModel AssetsVM
@inject LanguageService L

<div class="container mt-4">
    <h2>@L["CudaMemoryManagement"]</h2>

    <RadzenAlert Text="@(HomeVM.IsInitialized ? L["CudaInitialized"] : L["CudaNotInitialized"])"
                 Severity="@(HomeVM.IsInitialized ? AlertStyle.Success : AlertStyle.Warning)"
                 Visible="true" ShowCloseButton="false" />

    @if (HomeVM.IsInitialized)
    {
        <RadzenCard>
            <div class="rz-card-header">
                <h5>@L["VramStatus"]</h5>
            </div>
            <div class="rz-card-body">
                <p><strong>@L["AllocatedCudaMemObjects"]</strong> @(VM.MemoryInfos?.Length ?? 0)</p>
            </div>
        </RadzenCard>

        <h4>@L["MemoryList"]</h4>
        <RadzenAccordion>
            @if (VM.MemoryInfos != null && VM.MemoryInfos.Length > 0)
            {
                @foreach (var memInfo in VM.MemoryInfos)
                {
                    var isInDevice = !string.IsNullOrEmpty(memInfo.IndexPointer);
                    var accordionTitle = $"{memInfo.Id} ({VM.FormatSize(long.Parse(memInfo.TotalSize))}) ({memInfo.ElementType}) - {(isInDevice ? L["OnDevice"] : L["OnHost"])}";
                    <RadzenAccordionItem Text="@accordionTitle">
                        <div class="row">
                            <div class="col-md-8">
                                <table class="table table-sm">
                                    <tbody>
                                        <tr><th>@L["GuidId"]</th><td>@memInfo.Id</td></tr>
                                        <tr><th>@L["ElementType"]</th><td>@memInfo.ElementType</td></tr>
                                        <tr><th>@L["IndexPointer"]</th><td>@memInfo.IndexPointer</td></tr>
                                        <tr><th>@L["TotalLength"]</th><td>@memInfo.TotalLength</td></tr>
                                        <tr><th>@L["TotalSize"]</th><td>@VM.FormatSize(long.Parse(memInfo.TotalSize))</td></tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="col-md-4">
                                <div class="d-flex justify-content-end gap-2">
                                    @if (isInDevice)
                                    {
                                        <RadzenButton Icon="arrow_upward" ButtonStyle="ButtonStyle.Primary" 
                                                      Title="@L["PullToDevice"]" 
                                                      Click="() => VM.PullAsync(memInfo.IndexPointer, true)" />
                                    }
                                    else
                                    {
                                        <RadzenButton Icon="arrow_downward" ButtonStyle="ButtonStyle.Success" 
                                                      Title="@L["PushToHost"]" 
                                                      Click="@(() => VM.PushAssetAsync(memInfo.Id, false, memInfo.ElementType.Contains("audio", StringComparison.OrdinalIgnoreCase)))" />
                                    }
                                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" 
                                                  Title="@L["Delete"]" 
                                                  Click="() => VM.FreeMemoryAsync(memInfo.IndexPointer)" />
                                </div>
                            </div>
                        </div>

                        @if (memInfo.Pointers.Length > 1)
                        {
                            <h6 class="mt-3">@L["BufferAddresses"]</h6>
                            <table class="table table-sm"><thead><tr><th>@L["Pointer"]</th><th class="text-end">@L["Size"]</th></tr></thead><tbody>
                                @for (var pointerIndex = 0; pointerIndex < memInfo.Pointers.Length; pointerIndex++)
                                {
                                    var pointer = memInfo.Pointers[pointerIndex];
                                    var length = pointerIndex < memInfo.Lengths.Length ? memInfo.Lengths[pointerIndex] : "0";
                                    <tr>
                                        <td>@pointer</td>
                                        <td class="text-end">@(long.TryParse(length, out var bytes) ? VM.FormatSize(bytes) : length)</td>
                                    </tr>
                                }
                            </tbody></table>
                        }
                    </RadzenAccordionItem>
                }
            }
            else
            {
                <p class="text-muted">@L["NoCudaMemObjects"]</p>
            }
        </RadzenAccordion>
    }
    else
    {
        <p class="text-muted">@L["CudaNotInitialized"]</p>
    }
</div>

@code {
    protected override Task LoadViewModelAsync()
    {
        if (HomeVM.IsInitialized)
        {
            return VM.LoadMemoryListAsync();
        }

        return Task.CompletedTask;
    }
}