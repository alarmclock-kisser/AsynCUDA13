@page "/memory"
@inherits ViewModelComponentBase<MemoryViewModel>
@inject LanguageService L

<div class="container mt-4">
    <h2>@L["CudaMemoryManagement"]</h2>

    <RadzenAlert Text="@VM.InfoMessage"
                 Severity="@VM.InfoSeverity"
                 Visible="@VM.ShowInfoMessage" ShowCloseButton="@VM.ShowInfoCloseButton" />

    @if (VM.IsBackendInitialized)
    {
        <RadzenCard>
            <div class="rz-card-header">
                <h5>@L["VramStatus"]</h5>
            </div>
            <div class="rz-card-body">
                <p><strong>@L["AllocatedCudaMemobjects"]:</strong> @VM.MemoryInfos.Length</p>
            </div>
        </RadzenCard>

        <RadzenCard Class="mt-4">
            <h5>@L["PushAssets"]</h5>
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <RadzenDropDown @bind-Value="VM.SelectedAssetId"
                                    Placeholder="@L["SelectAsset"]"
                                    Data="@VM.AssetDropDownItems"
                                    TextProperty="Name"
                                    ValueProperty="Id"
                                    ShowClear="true"
                                    Disabled="@(!VM.AssetDropDownItems.Any())"
                                    Change="@VM.OnSelectedAssetChangedAsync" />
                </div>
                <div class="col-md-4 d-flex align-items-center gap-3">
                    <RadzenButton Text="@L["PushToCuda"]"
                                    ButtonStyle="ButtonStyle.Success"
                                    Click="@VM.OpenPushDialogAsync"
                                    Disabled="@(!VM.AssetPushable)" />
                    <RadzenLabel Text="@L["KeepData"]" />
                    <RadzenCheckBox @bind-Value="VM.KeepData" Name="KeepData" TValue="bool" Label="@L["KeepData"]" />
                    <RadzenLabel Text="@L["KeepBuffer"]" />
                    <RadzenCheckBox @bind-Value="VM.KeepBuffer" Name="KeepBuffer" TValue="bool" Label="@L["KeepBuffer"]" />
                </div>
            </div>
        </RadzenCard>

        <RuntimePushDialog @ref="VM.Dialog"
                        AssetName="@VM.SelectedAssetName"
                        IsAudio="@VM.SelectedAssetIsAudio"
                        ChunkSizeValue="@VM.ChunkSize"
                        OverlapValue="@VM.Overlap"
                        KeepDataValue="@VM.KeepData"
                        ImageFormatValue="@VM.ImageFormat" />

        <h4 class="mt-4">@L["MemoryList"]</h4>
        <RadzenAccordion Multiple="true">
            <Items>
                @foreach (var memInfo in VM.MemoryInfos)
                {
                    var assetId = memInfo.Id;
                    var accordionTitle = $"{memInfo.Id} ({VM.FormatSize(memInfo.TotalSize)}) ({memInfo.ElementType})";

                    <RadzenAccordionItem @key="memInfo.Id" Text="@accordionTitle">
                        <div class="row">
                            <div class="col-md-8">
                                <table class="table table-sm">
                                    <tbody>
                                        <tr><th>@L["GuidId"]</th><td>@memInfo.Id</td></tr>
                                        <tr><th>@L["CreatedAt"]</th><td>@memInfo.CreatedAt.ToString()</td></tr>
                                        <tr><th>@L["ElementType"]</th><td>@memInfo.ElementType</td></tr>
                                        <tr><th>@L["IndexPointer"]</th><td>@memInfo.IndexPointer</td></tr>
                                        <tr><th>@L["TotalLength"]</th><td>@memInfo.TotalLength</td></tr>
                                        <tr><th>@L["TotalSize"]</th><td>@VM.FormatSize(memInfo.TotalSize)</td></tr>
                                        <tr><th>@L["AssetRef"]</th><td>@(memInfo.AssetReferenceId?.ToString() ?? "---")</td></tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="col-md-4">
                                <div class="d-flex justify-content-end gap-2">
                                    <RadzenButton Icon="arrow_downward"
                                                  ButtonStyle="ButtonStyle.Primary"
                                                  Title="@L["PushToHost"]"
                                                  Click="@(() => VM.HandlePullAsync(memInfo.IndexPointer))"
                                                  Disabled="@(!memInfo.IsValid)" />
                                    <RadzenButton Icon="delete"
                                                  ButtonStyle="ButtonStyle.Danger"
                                                  Title="@L["Delete"]"
                                                  Click="@(() => VM.FreeMemoryAsync(memInfo.IndexPointer))" />
                                </div>
                            </div>
                        </div>

                        @if (memInfo.Pointers.Length > 1)
                        {
                            <h6 class="mt-3">@L["BufferAddresses"]</h6>
                            <table class="table table-sm"><thead><tr><th>@L["Pointer"]</th><th class="text-end">@L["Size"]</th></tr></thead><tbody>
                                @for (var pointerIndex = 0; pointerIndex < memInfo.Pointers.Length; pointerIndex++)
                                {
                                    var pointer = memInfo.Pointers[pointerIndex];
                                    var length = pointerIndex < memInfo.Lengths.Length ? memInfo.Lengths[pointerIndex] : "0";
                                    <tr>
                                        <td>@pointer</td>
                                        <td class="text-end">@(long.TryParse(length, out var bytes) ? VM.FormatSize(bytes) : length)</td>
                                    </tr>
                                }
                            </tbody></table>
                        }
                    </RadzenAccordionItem>
                }
            </Items>
        </RadzenAccordion>

        @if (VM.MemoryInfos.Length == 0)
        {
            <p class="text-muted">@L["NoCudaMemObjects"]</p>
        }
    }
    else
    {
        <p class="text-muted">@L["CudaNotInitialized"]</p>
    }
</div>

@code {
    protected override async Task LoadViewModelAsync()
    {
        await VM.LoadMemoryListAsync();
    }
}