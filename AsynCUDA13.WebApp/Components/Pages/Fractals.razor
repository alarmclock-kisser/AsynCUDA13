@page "/fractals"
@inherits ViewModelComponentBase<FractalsViewModel>
@inject ApiClient ApiClient
@inject LanguageService L
<div class="container mt-4">
    <h2>@L["CudaFractalsExplorer"]</h2>

    <RadzenAlert Text="@VM.InfoMessage"
                  Severity="@VM.InfoSeverity"
                  Visible="@VM.ShowInfoMessage" ShowCloseButton="@VM.ShowInfoCloseButton" />

    <div class="row mt-4">
        <div class="col-md-8">
            <RadzenImagePanel Text="@L["FractalView"]" 
                              ImagePath="@(VM.CurrentImageBase64Data != null ? $"data:image/{VM.ImageFormat};base64,{VM.CurrentImageBase64Data }" : "")" 
                              Options="@VM.PanelOptions" />
        </div>
        <div class="col-md-4">
            <div class="card p-3">
                <h4>@L["Controls"]</h4>
                <div class="mb-3">
                    <RadzenLabel Text="@L["Kernel"]" />
                    <RadzenDropDown TValue="string" Data="@VM.GenerativeKernels" 
                                    TextProperty="FunctionName" 
                                    @bind-Value="@VM.SelectedKernelName" 
                                    Style="width: 100%;" />
                </div>

                <div class="row mb-3">
                    <div class="col">
                        <RadzenLabel Text="@L["Width"]" />
                        <RadzenNumeric TValue="int" @bind-Value="@VM.ImageWidth" Style="width: 100%;" />
                    </div>
                    <div class="col">
                        <RadzenLabel Text="@L["Height"]" />
                        <RadzenNumeric TValue="int" @bind-Value="@VM.ImageHeight" Style="width: 100%;" />
                    </div>
                </div>

                <RadzenButton Text="@L["Execute"]" 
                             Click="() => VM.ExecuteAsync()" 
                             Disabled="@(!VM.CanExecute)" 
                             Variant="Variant.Flat" />
            </div>
        </div>
    </div>



</div>


@code {
    protected override async Task LoadViewModelAsync()
    {
        await this.VM.LoadGenerativeImageKernelsAsync();
    }
}
