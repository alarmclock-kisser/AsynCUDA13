@page "/Error"
@inject LanguageService L

<PageTitle>@L["ErrorPage"]</PageTitle>

<div class="container mt-4">
    <RadzenAlert Text="@L["ErrorOccurred"]" Severity="AlertSeverity.Danger" Visible="true" ShowCloseButton="false" />

    @if (ShowRequestId)
    {
        <RadzenAlert Text="@($"{L["RequestId"]}: {@RequestId}")" Severity="AlertSeverity.Info" Visible="true" ShowCloseButton="false" />
    }

    <RadzenCard>
        <RadzenBody>
            <h3>@L["DevelopmentMode"]</h3>
            <p>
                @L["DevelopmentModeExplanation"]
            </p>
            <p>
                <strong>@L["DevelopmentEnabledWarning"]</strong>
                @L["DevelopmentEnvVar"]
                @L["DevelopmentEnvVar2"]
            </p>
        </RadzenBody>
    </RadzenCard>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
