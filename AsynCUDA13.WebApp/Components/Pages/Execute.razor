@page "/execute"
@inherits ViewModelComponentBase<ExecuteViewModel>
@inject ApiClient ApiClient
@inject LanguageService L

<div class="container mt-4">
    <h2>@L["CudaKernelExecution"]</h2>

    <RadzenAlert Text="@VM.InfoMessage"
                 Severity="@VM.InfoSeverity"
                 Visible="@VM.ShowInfoMessage" ShowCloseButton="@VM.ShowInfoCloseButton" />

    <RadzenCard>
        <RadzenHeader>
            <h5>@L["KernelSelection"]</h5>
        </RadzenHeader>
        <RadzenCard>
            <RadzenDropDown TValue="string" @bind-Value="VM.SelectedKernelName"
                            Placeholder="@L["SelectKernel"]"
                            Data="@VM.CompiledKernels"
                            TextProperty="FunctionName" ValueProperty="FunctionName"
                            Change="@(args => VM.PrepareArguments(VM.GetSelectedKernel()))"
                            ShowClear="true"
                            Disabled="@(!VM.IsBackendInitialized)" />

            @if (VM.GetSelectedKernel() is { } selectedKernel && selectedKernel.ArgumentNames.Length > 0)
            {
                <h6 class="mt-3">@L["KernelArguments"]</h6>
                <div class="row g-3">
                    @for (int i = 0; i < selectedKernel.ArgumentNames.Length; i++)
                    {
                        var argumentType = i < selectedKernel.ArgumentTypes.Length ? selectedKernel.ArgumentTypes[i] : "unknown";
                        <div class="col-md-6">
                            <RadzenLabel Text="@($"{selectedKernel.ArgumentNames[i]} ({argumentType})")" />
                            <RadzenTextBox Value="@VM.GetArgumentValue(i)" Change="@(args => VM.SetArgumentValue(i, args?.ToString()))" />
                        </div>
                    }
                </div>
            }

            @if (VM.GetSelectedKernel() is { } kernel2)
            {
                <div class="mt-3">
                    <RadzenSwitch @bind-Value="VM.IsInPlace" />
                    <span class="ms-2">@(VM.IsInPlace ? L["InPlace"] : L["OutOfPlace"])</span>
                </div>
            }

            <RadzenButton Text="@L["Execute"]" 
                          ButtonStyle="ButtonStyle.Primary" 
                          Class="mt-3" 
                          Click="ExecuteKernel" 
                          Disabled="@(!VM.IsBackendInitialized || string.IsNullOrEmpty(VM.SelectedKernelName))" />
        </RadzenCard>
    </RadzenCard>

    @if (VM.MemoryInfos != null && VM.MemoryInfos.Length > 0)
    {
        <h4>@L["AvailableCudaMemobjects"]</h4>
        <RadzenPickList Data="@VM.MemoryInfos" TItem="RuntimeMemInfo" Enabled="@VM.IsBackendInitialized">
            <Template Context="context">
                <div class="card mb-2">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <span>@context.Id (@context.IndexPointer)</span>
                        <RadzenBadge Text="@context.ElementType" BadgeStyle="BadgeStyle.Info" />
                    </div>
                </div>
            </Template>
        </RadzenPickList>
    }
</div>

@code {
    protected override async Task LoadViewModelAsync()
    {
        await VM.LoadKernelsAsync();
        await VM.LoadMemoryListAsync();
    }

    private async Task ExecuteKernel()
    {
        if (!string.IsNullOrEmpty(VM.SelectedKernelName))
        {
            await VM.ExecuteKernelAsync();
        }
    }
}