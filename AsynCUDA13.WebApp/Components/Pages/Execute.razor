@page "/execute"
@inherits ViewModelComponentBase<ExecuteViewModel>
@inject ApiClient ApiClient
@inject LanguageService L

<div class="container mt-4">
    <h2>@L["CudaKernelExecution"]</h2>

    <RadzenAlert Text="@VM.InfoMessage"
                 Severity="@VM.InfoSeverity"
                 Visible="@VM.ShowInfoMessage" ShowCloseButton="@VM.ShowInfoCloseButton" />

    <RadzenCard>
        <RadzenHeader>
            <h5>@L["KernelSelection"]</h5>
        </RadzenHeader>
        <RadzenCard>
            <RadzenDropDown TValue="string" @bind-Value="VM.SelectedKernelName"
                            Placeholder="@L["SelectKernel"]"
                            Data="@VM.CompiledKernels"
                            TextProperty="FunctionName" ValueProperty="FunctionName"
                            ShowClear="true"
                            Change="@VM.OnSelectedKernelChangedAsync"
                            Disabled="@(!VM.IsBackendInitialized)" />

            <RadzenCard Class="mt-3">
                <RadzenHeader>
                    <h5>@L["KernelParameters"]</h5>
                </RadzenHeader>
                <RadzenBody>
                    @if (VM.SelectedKernelInfo != null)
                    {
                        <div class="row g-3">
                            @for (int i = 0; i < VM.SelectedKernelInfo.ArgumentsCount; i++)
                            {
                                int index = i;
                                string argName = VM.SelectedKernelInfo.ArgumentNames[i];
                                string argType = VM.SelectedKernelInfo.ArgumentTypes[i];
                                string argSignature = $"'{argName}' <{argType}>";
                                string? ptrType = VM.SelectedKernelInfo.IsPointerArgument(argName);

                                <RadzenLabel Text="@argSignature" Class="col-md-2 col-form-label" />

                                if (!string.IsNullOrEmpty(ptrType))
                                {
                                    <RadzenDropDown TValue="string" @bind-Value="VM.ExecuteRequest[index]"
                                    Placeholder="@L["SelectMemObject"]"
                                    Data="@VM.GetPointersForArgumentType(ptrType)"
                                    TextProperty="IndexPointer" ValueProperty="IndexPointer"
                                    ShowClear="true"
                                    Change="@(() => VM.OnSelectedKernelPointerChangedAsync(VM.ExecuteRequest[index]))"
                                    Disabled="@(!VM.IsBackendInitialized)" />
                                }
                                else if (VM.SelectedKernelInfo.IsBooleanArgument(argName) == true)
                                {
                                    <RadzenCheckBox TValue="string" @bind-Value="VM.ExecuteRequest[index]"
                                    Disabled="@(!VM.IsBackendInitialized)" />
                                }
                                else if (VM.SelectedKernelInfo.IsIntegerArgument(argName) == true)
                                {
                                    <RadzenNumeric TValue="string" @bind-Value="VM.ExecuteRequest[index]"
                                    Step="@VM.SelectedKernelInfo.GetStepSize(argName)"
                                    Min="@VM.SelectedKernelInfo.GetMinimumValue(argName)"
                                    Max="@VM.SelectedKernelInfo.GetMaximumValue(argName)"
                                    Disabled="@(!VM.IsBackendInitialized)" />
                                }
                                else if (VM.SelectedKernelInfo.IsDecimalArgument(argName) == true)
                                {
                                    <RadzenNumeric TValue="string" @bind-Value="VM.ExecuteRequest[index]"
                                    Step="@VM.SelectedKernelInfo.GetStepSize(argName)"
                                    Min="@VM.SelectedKernelInfo.GetMinimumValue(argName)"
                                    Max="@VM.SelectedKernelInfo.GetMaximumValue(argName)"
                                    Disabled="@(!VM.IsBackendInitialized)" />
                                }
                                else if (VM.SelectedKernelInfo.IsStructArgument(argName) == true)
                                {
                                    <RadzenTextBox TValue="string" @bind-Value="VM.ExecuteRequest[index]"
                                    Placeholder="@L["EnterStructData"]"
                                    Disabled="@(!VM.IsBackendInitialized)" />
                                }
                                else
                                {
                                    string valueErrMsg = L["UnsupportedArgumentType"] + $"#{index}: '{argName}' <{argType}>";
                                    <RadzenLabel Text="@valueErrMsg" Class="col-md-10 col-form-label text-danger" />
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">@L["NoParametersForSelectedKernel"]</p>
                    }
                </RadzenBody>
            </RadzenCard>
            <RadzenButton Text="@L["Execute"]" 
                          ButtonStyle="ButtonStyle.Primary" 
                          Class="mt-3" 
                          Click="VM.ExecuteKernelAsync" 
                          Disabled="@(!VM.CanExecute)" />
        </RadzenCard>
    </RadzenCard>

    @if (VM.MemoryInfos != null && VM.MemoryInfos.Length > 0)
    {
        <h4>@L["AvailableCudaMemobjects"]</h4>
        <RadzenPickList Data="@VM.MemoryInfos" TItem="RuntimeMemInfo" Enabled="@VM.IsBackendInitialized">
            <Template Context="context">
                <div class="card mb-2">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <span>@context.Id (@context.IndexPointer)</span>
                        <RadzenBadge Text="@context.ElementType" BadgeStyle="BadgeStyle.Info" />
                    </div>
                </div>
            </Template>
        </RadzenPickList>
    }
</div>

@code {
    protected override async Task LoadViewModelAsync()
    {
        await VM.LoadKernelsAndMemoryInfosAsync();
    }
}