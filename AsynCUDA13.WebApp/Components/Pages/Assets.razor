@page "/assets"
@inherits ViewModelComponentBase<AssetsViewModel>
@inject LanguageService L

<div class="container mt-4">
    <h2>@L["Assets"]</h2>

    <RadzenAlert Text="@VM.InfoMessage"
                 Severity="@VM.InfoSeverity"
                 Visible="@VM.ShowInfoMessage" ShowCloseButton="@VM.ShowInfoCloseButton" />

    <RadzenCard>
        <RadzenBody>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">@L["Upload Image"]</label>
                    <InputFile OnChange="@VM.OnInputFileChange" accept="image/*" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">@L["Upload Audio"]</label>
                    <InputFile OnChange="@VM.OnInputFileChange" accept="audio/*" class="form-control" />
                </div>
            </div>
        </RadzenBody>
    </RadzenCard>

    <h4>@L["Images"]</h4>
    @if (VM.ImageInfos.Length > 0)
    {
        <RadzenAccordion Multiple="true">
            <Items>
            @foreach (var image in VM.ImageInfos)
            {
                <RadzenAccordionItem @key="image.Id" Text="@image.Name" Selected="true">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-sm"><tbody><tr>
                                <th>@L["GuidId"]</th><td>@image.Id.ToString()</td><th>@L["Size"]</th><td>@image.OriginalSizeMb.ToString("F2") MB</td>
                                <th>@L["Width"]</th><td>@image.Width.ToString() px</td><th>@L["Height"]</th><td>@image.Height.ToString() px</td>
                                <th>@L["OnHost"]</th><td>@(!image.OnGpu ? L["Yes"] : L["No"])</td><th>@L["OnCuda"]</th><td>@(image.OnGpu ? $"cuda:" + (VM.ContextInfo?.DeviceInfo?.DeviceId?.ToString() ?? "*") : L["No"])</td>
                            </tr></tbody></table>
                        </div>
                    </div>
                    <div class="mt-2">
                        @if (VM.ImagePreviews.Length > 0)
                        {
                            var preview = VM.ImagePreviews.FirstOrDefault(p => p.Info.Id == image.Id);
                            if (preview != null && !string.IsNullOrEmpty(preview.Base64Data))
                            {
                                <div class="mb-3">
                                    <p class="text-muted">@L["Preview"]</p>
                                    <img src="@preview.Base64Image" class="img-fluid rounded" style="max-width: 100%; max-height: 300px;" />
                                </div>
                            }
                        }
                        <RadzenButton Text="@L["Delete"]" ButtonStyle="ButtonStyle.Danger" Click="() => VM.DeleteAssetAsync(image.Id.ToString())" />
                    </div>
                </RadzenAccordionItem>
            }
            </Items>
        </RadzenAccordion>
    }
    else
    {
        <p class="text-muted">@L["NoImages"]</p>
    }

    <h4>@L["Audios"]</h4>
    @if (VM.AudiosInfos != null && VM.AudiosInfos.Length > 0)
    {
        <RadzenAccordion Multiple="true">
            <Items>
            @foreach (var audio in VM.AudiosInfos)
            {
                <RadzenAccordionItem @key="audio.Id" Text="@audio.Name" Selected="true">
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-sm"><tbody><tr>
                                <th>@L["GuidId"]</th><td>@audio.Id.ToString()</td><th>@L["Duration"]</th><td>@audio.DurationSeconds.ToString("F2") s</td>
                                <th>@L["SampleRate"]</th><td>@audio.SampleRate.ToString() Hz</td><th>@L["Channels"]</th><td>@audio.Channels.ToString()</td><th>@L["BitDepth"]</th><td>@audio.BitDepth.ToString() bit</td>
                                <th>@L["OnHost"]</th><td>@(audio.OnGpu == false ? L["Yes"] : L["No"])</td><th>@L["OnCuda"]</th><td>@(audio.OnGpu ? $"cuda:{VM.ContextInfo?.DeviceInfo?.DeviceId.ToString() ?? "*"}" : L["No"])</td>
                            </tr></tbody></table>
                        </div>
                    </div>
                    <div class="mt-2">
                        @if (VM.AudioPreviews != null)
                        {
                            var preview = VM.AudioPreviews.FirstOrDefault(p => p.Info.Id == audio.Id);
                            if (preview != null && !string.IsNullOrEmpty(preview.Base64Data))
                            {
                                <div class="mb-3">
                                    <p class="text-muted">@L["Preview"]</p>
                                    <img src="@preview.Base64Image" class="img-fluid rounded" style="max-width: 100%; max-height: 100px;" />
                                </div>
                            }
                        }
                        <RadzenButton Text="@L["Delete"]" ButtonStyle="ButtonStyle.Danger" Click="() => VM.DeleteAssetAsync(audio.Id.ToString())" />
                    </div>
                </RadzenAccordionItem>
            }
            </Items>
        </RadzenAccordion>
    }
    else
    {
        <p class="text-muted">@L["NoAudios"]</p>
    }
</div>

@code {
    protected override Task LoadViewModelAsync()
    {
        return VM.LoadAssetsAsync();
    }
}