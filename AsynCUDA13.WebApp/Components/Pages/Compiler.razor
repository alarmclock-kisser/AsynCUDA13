@page "/compiler"
@inherits ViewModelComponentBase<CompilerViewModel>
@inject ApiClient ApiClient
@inject LanguageService L

<div class="container mt-4">
    <h2>@L["CudaKernelCompiler"]</h2>

    <RadzenAlert Text="@VM.InfoMessage"
                 Severity="@VM.InfoSeverity"
                 Visible="@VM.ShowInfoMessage" ShowCloseButton="@VM.ShowInfoCloseButton" />

    <RadzenCard>
        <RadzenCard>
            <h5>@L["KernelCode"]</h5>
        </RadzenCard>
        <RadzenBody>
            <RadzenTextArea @bind-Value="VM.KernelCode" Rows="10" Placeholder="@L["EnterCudaKernelCode"]" />
            <RadzenButton Text="@L["Compile"]" ButtonStyle="ButtonStyle.Success" Class="mt-2" Click=@VM.OpenCompileDialogAsync" Disabled="@(!VM.IsBackendInitialized || string.IsNullOrWhiteSpace(VM.KernelCode))" />
        </RadzenBody>
    </RadzenCard>

    <RuntimeCompileDialog @ref="VM.Dialog" />

    <RadzenPickList Data="@VM.Kernels" TItem="RuntimeKernelInfo">
        <Template Context="context">
            <div class="card mb-2">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <span>@context.FunctionName</span>
                    <RadzenBadge Text="@(VM.IsKernelCompiled(@context) ? L["Compiled"] : L["NotCompiled"])"
                                 BadgeStyle="@(VM.IsKernelCompiled(context) ? BadgeStyle.Success : BadgeStyle.Secondary)" />
                </div>
            </div>
        </Template>
    </RadzenPickList>

    @if (VM.Kernels == null || VM.Kernels.Length == 0)
    {
        <p class="text-muted">@L["NoCompiledKernelsFound"]</p>
    }
</div>

@code {
    protected override Task LoadViewModelAsync()
    {
        return VM.LoadKernelsAsync();
    }
}