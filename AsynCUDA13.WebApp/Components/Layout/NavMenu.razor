@implements IDisposable
@inject ApiClient ApiClient
@inject IJSRuntime JS

<aside class="app-sidebar @(SidebarOpen ? string.Empty : "is-collapsed")" @ref="sidebarRef">
    <div class="sidebar-brand">
        <RadzenButton Icon="menu" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                      Title="Seitenleiste ein-/ausblenden" Click="ToggleSidebar" />
        <RadzenLink Text="@Title" NavigateTo="/" />
    </div>

    <nav class="sidebar-navigation" aria-label="Hauptnavigation">
        <NavLink class="sidebar-link" href="/" Match="NavLinkMatch.All"><RadzenIcon Icon="home" /><span>Startseite</span></NavLink>
        <NavLink class="sidebar-link" href="/assets"><RadzenIcon Icon="image" /><span>Assets</span></NavLink>
        <NavLink class="sidebar-link" href="/memory"><RadzenIcon Icon="memory" /><span>Speicher</span></NavLink>
        <NavLink class="sidebar-link" href="/compiler"><RadzenIcon Icon="code" /><span>Compiler</span></NavLink>
        <NavLink class="sidebar-link" href="/execute"><RadzenIcon Icon="play_arrow" /><span>Ausführen</span></NavLink>
    </nav>

    <section class="sidebar-log" aria-label="Log">
        <div class="sidebar-log-header">
            <strong>@LogSource Log</strong>
            <span>@LogLines.Count</span>
        </div>
        <div class="sidebar-log-actions">
            <RadzenButton Icon="visibility" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Title="Frontend-Logs ein-/ausschalten" Click="ToggleFrontendLogs" />
            <RadzenButton Icon="wrap_text" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Title="Zeilenumbruch" Click="ToggleWordWrap" />
            <RadzenButton Icon="content_copy" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Title="Zeilen kopieren" Click="CopyLogAsync" />
            <RadzenButton Icon="download" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Title="Log herunterladen" Click="DownloadLogAsync" />
        </div>
        <div class="sidebar-log-lines @(WordWrap ? "word-wrap" : "no-word-wrap")" @ref="logContainerRef">
            @foreach (var entry in LogLines.TakeLast(50))
            {
                <div>@entry</div>
            }
        </div>
    </section>
    <div class="sidebar-resize-handle" @ref="resizeHandleRef"></div>
</aside>

@code {
    private bool SidebarOpen { get; set; } = true;
    private bool WordWrap { get; set; } = true;
    private List<string> LogLines { get; set; } = [];
    private readonly CancellationTokenSource LogRefreshCancellation = new();
    private ElementReference logContainerRef;
    private ElementReference sidebarRef;
    private ElementReference resizeHandleRef;
    private bool ShouldAutoScroll { get; set; } = true;
    private bool FrontendLogs { get; set; } = false;
    private bool SignalRConnected => ApiClient.IsSignalRConnected;
    private bool resizeInitialized;
    private string Title => this.ApiClient.BackendType.Equals("cuda", StringComparison.OrdinalIgnoreCase) ? "AsynCUDA13" : this.ApiClient.BackendType.Equals("opencl", StringComparison.OrdinalIgnoreCase) ? "AsynCL" : "AsynCPU";
    private string LogSource => FrontendLogs ? "Client" : "Server";

    protected override async Task OnInitializedAsync()
    {
        // Registriere das lokale LogWritten Event für Frontend-Logs
        StaticLogger.LogWritten += OnLocalLogWritten;
        await ConnectToSignalRAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !resizeInitialized)
        {
            resizeInitialized = true;
            await JS.InvokeVoidAsync("initSidebarResize", resizeHandleRef, sidebarRef);
        }
    }

    private async Task ScrollToBottomAsync()
    {
        await JS.InvokeVoidAsync("scrollToBottom", logContainerRef);
    }

    private void OnLocalLogWritten(DateTime timestamp, string line)
    {
        // Nur empfangen wenn auf Frontend-Logs umgestellt
        if (FrontendLogs)
        {
            _ = InvokeAsync(() =>
            {
                LogLines.Add(line);
                if (ShouldAutoScroll)
                {
                    _ = ScrollToBottomAsync();
                }
                StateHasChanged();
            });
        }
    }

    private async Task ConnectToSignalRAsync()
    {
        try
        {
            ApiClient.LogWritten += OnSignalRLogWritten;
            await ApiClient.StartSignalRConnectionAsync(LogRefreshCancellation.Token);
        }
        catch (Exception ex)
        {
            await StaticLogger.LogAsync(ex);
        }
    }

    private void OnSignalRLogWritten(DateTime timestamp, string line)
    {
        // Nur empfangen wenn nicht auf Frontend-Logs umgestellt
        if (!FrontendLogs)
        {
            _ = InvokeAsync(() =>
            {
                LogLines.Add(line);
                if (ShouldAutoScroll)
                {
                    _ = ScrollToBottomAsync();
                }
                StateHasChanged();
            });
        }
    }

    private async Task ToggleSidebar()
    {
        SidebarOpen = !SidebarOpen;
        await JS.InvokeVoidAsync("toggleSidebarCollapse", !SidebarOpen);
    }

    private void ToggleWordWrap()
    {
        WordWrap = !WordWrap;
    }

    private async Task ToggleFrontendLogs()
    {
        // Aktuelle Quelle merken
        bool wasFrontendLogs = FrontendLogs;

        // Liste löschen und Toggle durchführen
        this.LogLines.Clear();
        FrontendLogs = !FrontendLogs;

        // Wenn wir jetzt API-Logs verwenden wollen (FrontendLogs=false), aber vorher Frontend-Logs aktiv waren,
        // dann stellen wir sicher, dass die SignalR-Verbindung aktiv ist
        if (!FrontendLogs && wasFrontendLogs)
        {
            try
            {
                // SignalR-Verbindung sicherstellen
                await ApiClient.StartSignalRConnectionAsync(LogRefreshCancellation.Token);
            }
            catch (Exception ex)
            {
                await StaticLogger.LogAsync(ex);
            }
        }

        // Log-Liste laden
        try
        {
            var logLines = await ApiClient.GetLogListAsync(FrontendLogs, 50);
            LogLines.AddRange(logLines);
            _ = ScrollToBottomAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await StaticLogger.LogAsync(ex);
        }
    }

    private async Task CopyLogAsync()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", string.Join(Environment.NewLine, LogLines));
    }

    private async Task DownloadLogAsync()
    {
        await JS.InvokeVoidAsync("downloadTextFile", "asyncuda.log", string.Join(Environment.NewLine, await ApiClient.GetLogListAsync(FrontendLogs, 0)));
    }

    public void Dispose()
    {
        LogRefreshCancellation.Cancel();
        LogRefreshCancellation.Dispose();
        StaticLogger.LogWritten -= OnLocalLogWritten;
        _ = ApiClient.StopSignalRConnectionAsync();
        ApiClient.LogWritten -= OnSignalRLogWritten;
    }
}

