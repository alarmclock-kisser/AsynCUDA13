@implements IDisposable
@inject ApiClient ApiClient
@inject IJSRuntime JS

<aside class="app-sidebar @(SidebarOpen ? string.Empty : "is-collapsed")">
    <div class="sidebar-brand">
        <RadzenButton Icon="menu" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                      Title="Seitenleiste ein-/ausblenden" Click="ToggleSidebar" />
        <RadzenLink Text="AsynCUDA13" NavigateTo="/" />
    </div>

    <nav class="sidebar-navigation" aria-label="Hauptnavigation">
        <NavLink class="sidebar-link" href="/" Match="NavLinkMatch.All"><RadzenIcon Icon="home" /><span>Startseite</span></NavLink>
        <NavLink class="sidebar-link" href="/assets"><RadzenIcon Icon="image" /><span>Assets</span></NavLink>
        <NavLink class="sidebar-link" href="/memory"><RadzenIcon Icon="memory" /><span>Speicher</span></NavLink>
        <NavLink class="sidebar-link" href="/compiler"><RadzenIcon Icon="code" /><span>Compiler</span></NavLink>
        <NavLink class="sidebar-link" href="/execute"><RadzenIcon Icon="play_arrow" /><span>Ausführen</span></NavLink>
    </nav>

    <section class="sidebar-log" aria-label="Log">
        <div class="sidebar-log-header">
            <strong>Log</strong>
            <span>@LogLines.Count</span>
        </div>
        <div class="sidebar-log-actions">
            <RadzenButton Icon="visibility" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Title="Frontend-Logs ein-/ausschalten" Click="ToggleFrontendLogs" />
            <RadzenButton Icon="wrap_text" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Title="Zeilenumbruch" Click="ToggleWordWrap" />
            <RadzenButton Icon="content_copy" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Title="Zeilen kopieren" Click="CopyLogAsync" />
            <RadzenButton Icon="download" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Title="Log herunterladen" Click="DownloadLogAsync" />
        </div>
        <div class="sidebar-log-lines @(WordWrap ? "word-wrap" : "no-word-wrap")" @ref="logContainerRef">
            @foreach (var entry in LogLines.TakeLast(50))
            {
                <div>@entry</div>
            }
        </div>
    </section>
</aside>

@code {
    private bool SidebarOpen { get; set; } = true;
    private bool WordWrap { get; set; } = true;
    private List<string> LogLines { get; } = [];
    private readonly CancellationTokenSource LogRefreshCancellation = new();
    private ElementReference logContainerRef;
    private bool ShouldAutoScroll { get; set; } = true;
    private bool FrontendLogs { get; set; } = false;

    protected override void OnInitialized()
    {
        StaticLogger.LogWritten += OnLogWritten;
    }

    private async Task ScrollToBottomAsync()
    {
        await JS.InvokeVoidAsync("scrollToBottom", logContainerRef);
    }

    private void OnLogWritten(DateTime timestamp, string line)
    {
        _ = InvokeAsync(() =>
        {
            LogLines.Add(line);
            if (ShouldAutoScroll)
            {
                _ = ScrollToBottomAsync();
            }
            StateHasChanged();
        });
    }

    private void ToggleSidebar()
    {
        SidebarOpen = !SidebarOpen;
    }

    private void ToggleWordWrap()
    {
        WordWrap = !WordWrap;
    }

    private void ToggleFrontendLogs()
    {
        FrontendLogs = !FrontendLogs;
    }

    private async Task CopyLogAsync()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", string.Join(Environment.NewLine, LogLines));
    }

    private async Task DownloadLogAsync()
    {
        await JS.InvokeVoidAsync("downloadTextFile", "asyncuda.log", string.Join(Environment.NewLine, await ApiClient.GetLogListAsync(FrontendLogs, 0)));
    }

    private async Task RefreshApiLogsAsync(CancellationToken cancellationToken)
    {
        while (!cancellationToken.IsCancellationRequested)
        {
            var apiLines = await ApiClient.GetLogListAsync(FrontendLogs, 100);
            await InvokeAsync(() =>
            {
                if (apiLines.Length > 0)
                {
                    LogLines.Clear();
                    LogLines.AddRange(apiLines);
                    if (ShouldAutoScroll)
                    {
                        _ = ScrollToBottomAsync();
                    }
                    StateHasChanged();
                }
            });

            await Task.Delay(TimeSpan.FromSeconds(1), cancellationToken);
        }
    }

    public void Dispose()
    {
        LogRefreshCancellation.Cancel();
        LogRefreshCancellation.Dispose();
        StaticLogger.LogWritten -= OnLogWritten;
    }
}

