@using Radzen
@using Radzen.Blazor

@if (Visible)
{
    <div class="rz-dialog-wrapper rz-dialog-mask"
         style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-color: rgba(0, 0, 0, 1) !important; z-index: 20000; display: flex; align-items: center; justify-content: center;"
         @onclick="OnBackdropClick">

        <div class="rz-dialog @Class"
             style="width: @Width; height: @Height; max-width: 95vw; max-height: 95vh; display: flex; flex-direction: column; background-color: #1e1e22 !important; color: #ffffff !important; border: 1px solid #3a3a3e !important; box-shadow: 0 10px 40px rgba(0,0,0,0.8) !important; opacity: 1 !important; @Style"
             @onclick:stopPropagation="true">

            <div class="rz-dialog-titlebar" style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; background-color: #26262b !important; border-bottom: 1px solid #3a3a3e !important;">
                <span class="rz-dialog-title" style="font-weight: 600; color: #ffffff !important;">@Title</span>
                @if (ShowCloseButton)
                {
                    <RadzenButton Icon="close"
                                  ButtonStyle="ButtonStyle.Base"
                                  Variant="Variant.Text"
                                  Size="ButtonSize.Small"
                                  Click="CloseAsync"
                                  aria-label="Close" />
                }
            </div>

            <div class="rz-dialog-content" style="flex: 1; overflow-y: auto; padding: 1.25rem; background-color: #1e1e22 !important; color: #ffffff !important;">
                @ChildContent
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter]
    public string Title { get; set; } = "Dialog";

    [Parameter]
    public string Width { get; set; } = "50vw";

    [Parameter]
    public string Height { get; set; } = "50vh";

    [Parameter]
    public bool ShowCloseButton { get; set; } = true;

    [Parameter]
    public string Class { get; set; } = "";

    [Parameter]
    public string Style { get; set; } = "";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private async Task CloseAsync()
    {
        if (!Visible) return;
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    private async Task OnBackdropClick()
    {
        if (ShowCloseButton)
        {
            await CloseAsync();
        }
    }
}