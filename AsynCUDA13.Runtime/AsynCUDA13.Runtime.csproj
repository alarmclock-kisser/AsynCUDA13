<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ManagedCuda-13" Version="13.0.64" />
    <PackageReference Include="ManagedCuda-CUFFT" Version="13.0.64" />
    <PackageReference Include="ManagedCuda-NVRTC" Version="13.0.64" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AsynCUDA13.Shared\AsynCUDA13.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Kernels\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
