{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Backend": "CUDA", // CUDA or OpenCL
  "SwitchBackendIfUnavailable": true,

  "CORS": {
    "AllowedOrigins": [
      "https://localhost:7246",
      "http://localhost:5014"
    ]
  },

  "LogDirectory": "",
  "CreateLogFile": true,
  "MaxLogFiles": 16,
  "FilterPhrase": "[[[",
  "EchoToConsole": true,
  "EchoToConsoleKeyPhrases": [
    "[[["
  ],
  "InnerExOpeningBracket": "(",
  "InnerExClosingBracket": ")",
  "InnerExSeparator": " "
}
